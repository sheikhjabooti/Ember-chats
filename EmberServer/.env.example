# Copy to .env for local development.
PORT=4000
DATABASE_FILE="./ember.db"
# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
BREAKOUT_WARNING_WINDOW_SECONDS=15
BREAKOUT_DEFAULT_INACTIVITY_SECONDS=1800
BREAKOUT_EMPTY_GRACE_SECONDS=60
CORS_ORIGIN="*"
